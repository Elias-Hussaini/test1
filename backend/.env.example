# ═══════════════════════════════════════════
# LINGO Backend — Environment Variables
# ═══════════════════════════════════════════
# این فایل را به .env کپی کنید و مقادیر واقعی را جایگزین کنید.

# ─── Server ─────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# آدرس فرانت‌اند برای CORS (چندتا با کاما جدا کنید)
# 3000 = frontend landing
# 3001 = admin panel
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ─── Database ───────────────────────────────
# dev: SQLite — فایل محلی
DATABASE_URL="file:./dev.db"

# prod: PostgreSQL — وقتی آماده شدید، خط بالا را کامنت و خط پایین را فعال کنید
# DATABASE_URL="postgresql://user:password@localhost:5432/lingo?schema=public"

# ─── JWT ────────────────────────────────────
# یک رشته‌ی تصادفی 64 بایتی — با `openssl rand -hex 64` بسازید
JWT_ACCESS_SECRET="CHANGE_ME_TO_A_RANDOM_64_BYTE_HEX_STRING"
JWT_REFRESH_SECRET="CHANGE_ME_TO_ANOTHER_RANDOM_64_BYTE_HEX_STRING"

# طول عمر توکن‌ها (به ثانیه)
JWT_ACCESS_TTL=900          # 15 دقیقه
JWT_REFRESH_TTL=604800      # 7 روز

# ─── Security ───────────────────────────────
# طول حداقل رمز عبور
PASSWORD_MIN_LENGTH=8

# Rate limiting: تعداد درخواست در دقیقه برای auth endpoints
RATE_LIMIT_AUTH_PER_MINUTE=5

# ─── Email (Resend) ─────────────────────────
# کد تأیید ایمیل و بازیابی رمز با Resend ارسال می‌شود: https://resend.com/api-keys
# کلید واقعی را فقط در backend/.env بگذار (این فایل کامیت می‌شود، .env نه).
# اگر RESEND_API_KEY خالی باشد، در حالت development کد در ترمینال سرور چاپ می‌شود.
RESEND_API_KEY=

# برای تست بدون دامنه: onboarding@resend.dev — فقط به ایمیل خودِ صاحب حساب Resend می‌رسد.
# برای ارسال به همه، دامنه‌ات را در Resend تأیید کن و مثلاً: LINGO <noreply@yourdomain.com>
EMAIL_FROM="LINGO <onboarding@resend.dev>"

# ─── Logging ────────────────────────────────
LOG_LEVEL=info               # trace | debug | info | warn | error | fatal
